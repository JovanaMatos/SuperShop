@model IEnumerable<SuperShop.Data.Entities.OrderDetailTemp>

@{
    ViewData["Title"] = "Create Order";
}

<h2>New Order</h2>

<p>
    <a asp-action="AddProduct" class="btn btn-primary"><i class="fa fa-plus"></i> Add Product</a>
    <a asp-action="ConfirmOrder" class="btn btn-success"><i class="fa fa-check"></i> Confirm Order</a>
</p>

@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    Product
                </th>
                <th>
                    Price
                </th>
                <th>
                    Quantity
                </th>
                <th>
                    Value
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.Product.Name
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Price)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Quantity)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Value)
                    </td>
                    <td>
                        <a asp-action="Increase" asp-route-id="@item.Id" class="btn btn-info btn-sm"><i class="fa fa-plus"></i></a>
                        <a asp-action="Decrease" asp-route-id="@item.Id" class="btn btn-warning btn-sm"><i class="fa fa-minus"></i></a>
                        <a asp-action="DeleteItem" asp-route-id="@item.Id" class="btn btn-danger btn-sm"><i class="fa fa-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No products added yet. Click "Add Product" to start your order.</p>
}

<div>
    <a asp-action="Index" class="btn btn-success"><i class="fa fa-chevron-left"></i> Back to List</a>
</div>
